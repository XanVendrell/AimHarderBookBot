# Credenciales de Aimharder
AIMHARDER_EMAIL=tu_email@ejemplo.com
AIMHARDER_PASSWORD=tu_contraseña

# Configuración del Box de CrossFit / Centro Deportivo
BOX_URL=https://tu_box.aimharder.com/
BOX_ID=9221
BOX_NAME=Mi Box CrossFit

# Configuración por defecto (si no usas TARGETS en JSON)
TARGET_TIME=17:30
TARGET_CLASS_NAME=CrossFit
TARGET_DAYS=0,1,2,3,4
DAYS_AHEAD=5

# Colección de Objetivos de Reserva en JSON (Soporta múltiples clases, horas y días de la semana)
# Días: 0=Lunes, 1=Martes, 2=Miércoles, 3=Jueves, 4=Viernes, 5=Sábado, 6=Domingo
TARGETS=[{"name": "CrossFit", "time": "17:30", "days": [0,1,2,3,4]}]

# Configuración de Notificaciones por Telegram
TELEGRAM_BOT_TOKEN=tu_bot_token_telegram
TELEGRAM_CHAT_ID=tu_chat_id_telegram
